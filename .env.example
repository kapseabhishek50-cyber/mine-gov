# Frontend (empty uses Vite's same-origin /api proxy)
VITE_API_URL=

# Backend
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# Firebase Cloud Firestore (choose one configuration method)
# Option 1: Individual Service Account credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option 2: Path to Firebase Service Account JSON file or inline JSON/Base64
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 3: Local Firebase Firestore Emulator (e.g. 127.0.0.1:8080)
FIRESTORE_EMULATOR_HOST=

# Optional AI configuration
AI_PROVIDER=auto
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
# Optional OpenAI-compatible endpoint (defaults to OpenAI)
AI_BASE_URL=https://api.openai.com/v1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
