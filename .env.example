# Frontend (empty uses Vite's same-origin /api proxy; the Express server also
# serves the built dist/ bundle, so one service can host the API and the app)
VITE_API_URL=

# Backend
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# Demo/preview deployment without Firebase Firestore.
# Set to true ONLY for a demo or preview environment: the API persists to
# server/data/store.json (ephemeral on most hosts) and seeds DEMO DATA so the
# published site is usable. Leave unset for a real operational deployment.
ALLOW_LOCAL_DEMO_STORE=

# Allow the app to be embedded in an iframe (hosted previews). Ignored in
# non-production environments, which always allow embedding.
ALLOW_IFRAME_EMBED=

# Optional: copy the built frontend from another location (defaults to ./dist)
WEB_ROOT=

# Firebase Cloud Firestore (choose one configuration method)
# Option 1: Individual Service Account credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option 2: Path to Firebase Service Account JSON file or inline JSON/Base64
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option 3: Local Firebase Firestore Emulator (e.g. 127.0.0.1:8080)
FIRESTORE_EMULATOR_HOST=

# Optional AI configuration
AI_PROVIDER=auto
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
# Optional OpenAI-compatible endpoint (defaults to OpenAI)
AI_BASE_URL=https://api.openai.com/v1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
